# Copy to `.env` and adjust. NEVER commit the real `.env` file.

# --- PostgreSQL (consumed by docker-compose.yml AND the backend) ---
POSTGRES_USER=sports_admin
POSTGRES_PASSWORD=change_me_in_dotenv
POSTGRES_DB=sports_ecosystem
POSTGRES_PORT=5432
# Host as seen from the machine running the backend (use `db` if the backend runs in Compose).
POSTGRES_HOST=localhost
# Optional: full SQLAlchemy URL, overrides the POSTGRES_* parts above.
# DATABASE_URL=postgresql+psycopg2://sports_admin:change_me_in_dotenv@localhost:5432/sports_ecosystem

# --- Backend ---
ENVIRONMENT=development
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be changed (>= 32 random chars) when ENVIRONMENT is staging/production.
SECRET_KEY=change_me_generate_a_random_64_char_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
BCRYPT_ROUNDS=12
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
