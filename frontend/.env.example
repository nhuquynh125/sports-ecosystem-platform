# Copy to `.env` (never commit it).
# Leave VITE_API_BASE_URL unset in development: requests go to /api/v1 and the Vite dev server
# proxies them to VITE_PROXY_TARGET. Set it for a production build served from another origin.
# VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_PROXY_TARGET=http://localhost:8000
